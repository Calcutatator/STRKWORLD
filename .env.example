# Copy to .env.local and fill in. .env.local is gitignored.
# NEVER commit real keys.

# Starknet RPC — free key from https://www.alchemy.com
VITE_STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_STARKNET_CHAIN_ID=SN_MAIN

# STRK20 privacy pool (mainnet, v2.0)
VITE_STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Multiplayer lobby — presence only, never sees an address
VITE_LOBBY_URL=ws://localhost:2567

# Server-side only. Must never be exposed to the browser bundle —
# no VITE_ prefix, and proxied through our own backend.
AVNU_PAYMASTER_API_KEY=
