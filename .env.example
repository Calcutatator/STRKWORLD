# Copy to .env.local and fill in. .env.local is gitignored.
# NEVER commit real keys.

# Starknet RPC.
#
# ⚠ A VITE_ prefixed value is COMPILED INTO THE PUBLIC BROWSER BUNDLE and
#   shipped to every player. "Never commit it" protects nothing in production.
#   Use a domain-allowlisted key here, or better, proxy reads through our own
#   backend so a third party never sees player IP + intended recipient + timing.
#   See docs/DECISIONS.md D-014.
VITE_STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/DOMAIN_ALLOWLISTED_KEY

# Server-side RPC, used by the backend proxy. No VITE_ prefix — never bundled.
STARKNET_RPC_URL=
VITE_STARKNET_CHAIN_ID=SN_MAIN

# Local browser testing defaults to the deterministic demo. Set this exact
# value to exercise real Wallet Standard discovery and Ready in `npm run dev`.
# Production builds always use the real wallet path regardless of this flag.
VITE_WALLET_MODE=demo

# Same-origin Backend edge. Cross-origin values are refused by production
# wallet configuration, because the Backend intentionally emits no CORS data.
VITE_BACKEND_BASE_URL=/api

# STRK20 privacy pool (mainnet, v2.0)
VITE_STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Multiplayer lobby — presence only, never sees an address
VITE_LOBBY_URL=ws://localhost:2567

# Server-side only. Must never be exposed to the browser bundle —
# no VITE_ prefix, and proxied through our own backend.
AVNU_PAYMASTER_API_KEY=
