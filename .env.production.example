# STRKWORLD — production environment template
#
# Copy to the platform's secret store. NEVER commit a filled-in copy. `.env*`
# is gitignored with only the two `.example` templates re-included, so a
# `.env.production` filled in from this file cannot be committed by accident.
# Every value below is a placeholder — none is real.
#
# ---------------------------------------------------------------------------
# READ THIS FIRST: this is the composition root's strict runtime contract.
# ---------------------------------------------------------------------------
# `apps/backend/src/environment.ts` reads these names at startup and fails
# closed on missing, placeholder, malformed or out-of-range values without
# printing the value. `apps/backend/src/server.ts` then constructs the backend
# ports and logging-free HTTP listener from that parsed configuration. The
# comments below cite the option each variable feeds.
#
# ---------------------------------------------------------------------------
# CUSTODY LEGEND — who supplies it, and how it stays secret
# ---------------------------------------------------------------------------
#   PUBLIC   On-chain or otherwise already public. Committing it leaks nothing.
#            Still set explicitly; a wrong pool address is a funds bug.
#   SECRET   Never in git, never in a Dockerfile, never in a build ARG, never
#            in a client bundle. Injected at run time from the platform secret
#            store. Rotatable — see docs/OPS.md "Secret rotation".
#   PUBLISHED-BY-DESIGN  Compiled into the browser bundle by Vite and served to
#            every player. Calling it a secret is a lie. The only protection is
#            a domain allowlist on the provider side.
#
# D-045 selects a Fly.io one-app topology, but the account, domain and secret
# store are not configured. Do not deploy until the remaining operational
# values and platform logging/header checks are complete.


# ===========================================================================
# BACKEND — server-side only. No VITE_ prefix; never bundled.
# ===========================================================================

# --- Runtime -------------------------------------------------------------
# Supplied by: the hosting platform. PUBLIC.
# The container defaults to 8080 and the listener must bind 0.0.0.0.
PORT=8080

# Supplied by: deployment lane. PUBLIC.
# Path to the compiled composition root inside the image. Default is
# apps/backend/src/server.js; override only if the Backend lane names it
# differently. See deploy/backend/launch.mjs.
BACKEND_ENTRY=apps/backend/src/server.js


# --- Starknet RPC (feeds StarknetRpcPoolPort, apps/backend/src/starknet-rpc.ts:9)
# Supplied by: Alchemy under D-046. SECRET; no account/key is committed here.
# The URL embeds the API key, so the whole URL is the secret. This is the
# server-side key — distinct from the browser one below, and it must NOT be
# domain-allowlisted (there is no Origin header on a server call); restrict it
# by IP or by provider-side key scoping instead. Rotate by minting a second key,
# deploying, then revoking the first (docs/OPS.md).
# → StarknetRpcOptions.rpcUrl
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/REPLACE_WITH_SERVER_KEY

# Supplied by: the STRK20 protocol. PUBLIC (on-chain address, mainnet v2.0).
# → StarknetRpcOptions.poolAddress, BackendConfig.poolAddress
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Supplied by: the STRK20 protocol. PUBLIC (STRK token address).
# → StarknetRpcOptions.feeToken, BackendConfig.feeToken
STRK20_FEE_TOKEN=0xREPLACE_WITH_STRK_TOKEN_ADDRESS

# Supplied by: project lead / protocol. PUBLIC. Optional; port default is 10.
# → StarknetRpcOptions.noteMaturityBlocks
STRK20_NOTE_MATURITY_BLOCKS=10


# --- AVNU paymaster (feeds AvnuPaymasterPort, apps/backend/src/avnu-paymaster.ts:14)
# Supplied by: AVNU, on request. SECRET — this is our money.
# This key spends the sponsorship budget. It is the single highest-value secret
# in the deployment and the reason the backend exists at all: it cannot ship to
# a browser (D-013, D-014). Procurement is UNDECIDED — docs/OPS.md.
# → AvnuPaymasterOptions.apiKey
AVNU_PAYMASTER_API_KEY=REPLACE_WITH_AVNU_PAYMASTER_KEY

# Supplied by: AVNU. PUBLIC. Optional; SDK default applies when unset.
# → AvnuPaymasterOptions.paymasterBaseUrl
AVNU_PAYMASTER_BASE_URL=

# Supplied by: AVNU. PUBLIC. Optional; SDK default applies when unset.
# → AvnuSwapPlannerOptions.baseUrl (apps/backend/src/avnu-swap-planner.ts:18)
AVNU_BASE_URL=

# Supplied by: project lead. PUBLIC. Mainnet from day one (D-001).
# → AvnuSwapPlannerOptions.chainId
STARKNET_CHAIN_ID=SN_MAIN


# --- Fee authorization (feeds HmacAuthorizationCodec, apps/backend/src/authorization.ts:45)
# Supplied by: generated by us at deploy time. SECRET.
# Minimum 32 characters — the constructor throws below that
# (apps/backend/src/authorization.ts:49). Generate with
# `openssl rand -base64 48`. It signs the stateless fee authorization that
# binds route, fee token, amount and block window; forging it means forging a
# sponsorship grant. The production codec accepts exactly one secret: rotation
# requires a coordinated replacement and backend restart or redeploy, and
# every unconsumed authorization issued under the old secret then fails
# verification. There is no overlap window today; supporting one would require
# a new reviewed dual-secret implementation and decision. See docs/OPS.md.
# MemoryAuthorizationCodec is unsigned and test-only; production must use HMAC.
#
# The placeholder below is deliberately SHORTER than 32 characters so that
# deploying without substituting it throws at startup. A placeholder long
# enough to pass the length guard would let an unsubstituted deploy come up
# cleanly, signing every sponsorship grant with an HMAC key published in this
# repository. That is the only guard this value has — do not lengthen it.
FEE_AUTHORIZATION_SECRET=REPLACE_WITH_RANDOM_SECRET


# --- Request limits (feed BackendConfig, apps/backend/src/types.ts:25) -----
# Supplied by: project lead / ops. PUBLIC — these are policy, not secrets.

# → BackendFetchHandlerOptions.maxRequestBytes (apps/backend/src/http.ts:3)
BACKEND_MAX_REQUEST_BYTES=2500000
# → BackendConfig.maxCalldataItems
BACKEND_MAX_CALLDATA_ITEMS=256
# → BackendConfig.maxProofBytes
BACKEND_MAX_PROOF_BYTES=2000000
# → BackendConfig.requestTimeoutMs
BACKEND_REQUEST_TIMEOUT_MS=20000


# --- Kill switches --------------------------------------------------------
# Supplied by: ops, at incident time. PUBLIC.
# Global kill switch. `false` makes every private route answer 503
# SERVICE_DISABLED (apps/backend/src/api.ts:97-100) without taking the city
# down — buildings lock, nothing falls back to a public transaction (D-018).
# → BackendConfig.globalEnabled
BACKEND_GLOBAL_ENABLED=true


# --- Aggregate sponsorship controls (D-026) -------------------------------
# Supplied by: project lead. PUBLIC.
# These are GLOBAL and UNKEYED on purpose. Do not add an account-, wallet- or
# IP-keyed variable here: that would rebuild the correlation database D-014 and
# D-026 exist to prevent. A rejection increments an aggregate counter only.
# → BackendConfig.rateLimit
BACKEND_RATE_LIMIT_MAX_REQUESTS=120
BACKEND_RATE_LIMIT_WINDOW_MS=60000
# → BackendConfig.sponsorshipBudget — token-denominated, in fee-token wei.
# 0 = REJECTS ALL SPONSORED TRAFFIC. Fail-closed on purpose (an unset budget
# must not mean an unlimited one), but it is a valid config that passes
# validation and then refuses every request: AggregateBudget.take returns
# false for any positive amount (apps/backend/src/metrics.ts:55). Set a real
# ceiling before launch. This doubles as the sponsorship kill switch.
BACKEND_SPONSORSHIP_MAX_FEE_AMOUNT=REPLACE_WITH_BUDGET_IN_FEE_TOKEN_WEI
BACKEND_SPONSORSHIP_WINDOW_MS=3600000
# → BackendConfig.submissionQueue
BACKEND_QUEUE_MAX_IN_FLIGHT=4
BACKEND_QUEUE_MAX_QUEUED=64

# NOTE (D-026): the in-memory AggregateRateLimiter and AggregateBudget
# (apps/backend/src/metrics.ts:61, :37) are PROCESS-LOCAL. Two instances means
# two budgets and two rate windows — the cap is not deployment-wide. Run a
# single admission-control instance, or supply the atomic adapters
# `BackendApiOptions.rateLimiter` / `.sponsorshipBudget`. If a shared store is
# introduced it needs a connection string here, and it must hold aggregate
# counters only — never a per-request key.


# --- Route policy (feeds BackendConfig.routes, apps/backend/src/types.ts:16)
# Supplied by: project lead. PUBLIC. Per-route kill switch plus fee ceiling,
# queue bound and token allowlist. Disabling a route locks that building; it
# never degrades to a public path (D-018).
# `quoteBound` is not listed: it is fixed per route in code (swap only).
#
# MAX_RELAY_FEE of 0 REJECTS ALL TRAFFIC ON THAT ROUTE. It is a valid config —
# validation only rejects a negative (apps/backend/src/api.ts:506) — and then
# every request fails the ceiling check, because the test is
# `fee.amount <= 0n || fee.amount > policy.maxRelayFee`
# (apps/backend/src/api.ts:151, :320, :399). Fail-closed is the right default,
# but it is not a working value: set a real ceiling per route before launch.

BACKEND_ROUTE_TRANSFER_ENABLED=true
BACKEND_ROUTE_TRANSFER_MAX_RELAY_FEE=REPLACE_WITH_FEE_CEILING_IN_WEI
BACKEND_ROUTE_TRANSFER_MAX_QUEUE_DELAY_MS=45000
BACKEND_ROUTE_TRANSFER_ALLOWED_TOKENS=0xREPLACE_WITH_STRK_TOKEN_ADDRESS

BACKEND_ROUTE_UNSHIELD_ENABLED=true
BACKEND_ROUTE_UNSHIELD_MAX_RELAY_FEE=REPLACE_WITH_FEE_CEILING_IN_WEI
BACKEND_ROUTE_UNSHIELD_MAX_QUEUE_DELAY_MS=45000
BACKEND_ROUTE_UNSHIELD_ALLOWED_TOKENS=0xREPLACE_WITH_STRK_TOKEN_ADDRESS

# Quote-bound: never delayed and never queued (D-015, D-023), so a
# MAX_QUEUE_DELAY_MS of 0 is correct here and is NOT a placeholder.
BACKEND_ROUTE_SWAP_ENABLED=true
BACKEND_ROUTE_SWAP_MAX_RELAY_FEE=REPLACE_WITH_FEE_CEILING_IN_WEI
BACKEND_ROUTE_SWAP_MAX_QUEUE_DELAY_MS=0
BACKEND_ROUTE_SWAP_ALLOWED_TOKENS=0xREPLACE_WITH_STRK_TOKEN_ADDRESS
BACKEND_ROUTE_SWAP_MAX_SLIPPAGE_BPS=50


# ===========================================================================
# WEB — build-time. Vite compiles every VITE_ value into the public bundle.
# ===========================================================================
# Set these in the STATIC BUILD environment, not on the backend host. They are
# PUBLISHED-BY-DESIGN: shipped to every player. A "secret" here is not secret.

# Supplied by: Alchemy under D-046. PUBLISHED-BY-DESIGN.
# Must be a DOMAIN-ALLOWLISTED key, and distinct from STARKNET_RPC_URL above.
# It may serve only reads that are already public and unlinkable. Anything that
# ties a player IP to an intended recipient or to timing — the Post Office
# `get_public_key` preflight, receipt polling — goes through the backend proxy
# instead. That is the whole point of D-014.
VITE_STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/REPLACE_WITH_DOMAIN_ALLOWLISTED_KEY

# Supplied by: project lead. PUBLIC.
VITE_STARKNET_CHAIN_ID=SN_MAIN

# Supplied by: the STRK20 protocol. PUBLIC.
VITE_STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Supplied by: deployment lane, once the lobby host is chosen. PUBLIC.
# Must be wss:// in production. Presence only; it never sees an address.
VITE_LOBBY_URL=wss://REPLACE-WITH-LOBBY-HOST

# Supplied by: deployment lane. PUBLIC — but see the constraint below.
# Base URL passed to BackendPrivacyClient
# (packages/privacy/src/wallet-api/backend-client.ts:13).
#
# CONSTRAINT — this must be SAME-ORIGIN with the web app. The backend edge
# emits no CORS headers and reflects no Origin, by design
# (apps/backend/src/http.ts:12-13). A cross-origin value such as
# https://api.example.com will be blocked by the browser and every private
# action will fail. Deploy the backend behind a path on the web origin (a
# reverse proxy or platform rewrite) and set a path prefix here. This is a
# hard input to the hosting decision — docs/OPS.md DECISIONS-NEEDED.
VITE_BACKEND_BASE_URL=/api


# ===========================================================================
# DELIBERATELY ABSENT
# ===========================================================================
# - No paymaster key, RPC key or HMAC secret with a VITE_ prefix. Anything
#   VITE_-prefixed is public (D-014).
# - No PROVING_SERVICE_URL, no viewing key, no note-set store, no user secret.
#   STRKWORLD runs no privacy infrastructure and holds no user key (D-002).
# - No account-, wallet- or IP-keyed limit, quota or budget variable (D-026).
# - No log level, log destination, APM key, tracing endpoint or sampling rate.
#   There is no per-request logging to configure, and adding an agent that
#   observes requests would violate D-014 (docs/OPS.md "Logging and monitoring").
